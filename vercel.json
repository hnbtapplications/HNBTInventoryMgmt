{
  "framework": "vite",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/refurbished-laptop", "destination": "/refurbished-laptop.html" },
    { "source": "/refurbished-laptop/", "destination": "/refurbished-laptop.html" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}